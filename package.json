{
  "name": "postflare",
  "version": "0.2.0",
  "private": true,
  "description": "Self-hosted webmail on Cloudflare Workers, D1, R2, Email Routing, and Email Sending.",
  "license": "MIT",
  "author": "Yuki <admin@yuki.sh>",
  "type": "module",
  "imports": {
    "#/*": "./src/*",
    "~/*": "./*"
  },
  "scripts": {
    "build": "bun build index.html --outdir dist --production",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "bun run db:migrate:remote && wrangler deploy",
    "dev": "bun run types && bun run db:migrate:local && bun scripts/dev.ts",
    "format": "prettier \"**/*.{json,md,ts,tsx,yaml,yml}\" --write --experimental-cli",
    "format:check": "prettier \"**/*.{json,md,ts,tsx,yaml,yml}\" --check --experimental-cli",
    "lint": "eslint --cache",
    "lint:fix": "eslint --fix --cache",
    "prepare": "husky",
    "typecheck": "bun run types && tsc --noEmit",
    "types": "wrangler types ./types/worker-configuration.d.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@remixicon/react": "^4.9.0",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.17",
    "mimetext": "^3.0.28",
    "postal-mime": "^4.0.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "unism": "^0.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.8",
    "prettier-plugin-sort": "^1.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "wrangler": "^4.150.0"
  },
  "devEngines": {
    "runtime": {
      "name": "bun",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "bun",
      "onFail": "warn"
    }
  },
  "cloudflare": {
    "bindings": {
      "ATTACHMENTS": {
        "description": "Stores message attachments and template images."
      },
      "DB": {
        "description": "Stores users, messages, templates, and attachment metadata."
      },
      "MAIL_DOMAIN": {
        "description": "The domain you send and receive mail on, for example `example.com`."
      }
    }
  }
}
