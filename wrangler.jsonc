{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "postflare",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-13",
  "vars": {
    "MAIL_DOMAIN": "yuki.sh",
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "triggers": {
    "crons": ["0 16 * * *"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "postflare",
      "database_id": "e74c4287-134f-4174-a561-a51e9ab19f15",
    },
  ],
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "postflare-attachments",
    },
  ],
  "send_email": [{ "name": "EMAIL" }],
}
